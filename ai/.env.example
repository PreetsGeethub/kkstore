# Copy to .env for local development. Never commit real secrets.
BACKEND_URL=http://localhost:5000

# Use Ollama locally; set LLM_PROVIDER=openrouter in the deployed environment.
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=120

# Local-only LLM settings (used when LLM_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120

# Hosted LLM settings (required when LLM_PROVIDER=openrouter).
OPENROUTER_API_KEY=
# Set this to an OpenRouter model slug that supports tool calling.
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=KK Store AI Assistant

REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
# Required only for authenticated Qdrant Cloud deployments.
QDRANT_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HTTP_TIMEOUT_SECONDS=15
# Comma-separated exact origins allowed to call the AI API.
AI_ALLOWED_ORIGINS=http://localhost:3000
