# Copy to .env and fill in values for your environment. Never commit secrets.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
# Optional: set only when frontend, API and AI use subdomains of the same domain.
# Example: .kkstore.in
COOKIE_DOMAIN=

# Supabase PostgreSQL URLs. DATABASE_URL is used by the running app;
# DIRECT_URL is used by Prisma CLI operations and migrations.
DATABASE_URL=
DIRECT_URL=

# Generate unique, strong random secrets for each value.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_PROFILE_COMPLETION_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_PROFILE_COMPLETION_EXPIRES_IN=10m
BCRYPT_SALT_ROUNDS=12

# Optional Google OAuth (required only if Google sign-in is enabled).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Optional payment integration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Gemini integration used by backend features.
GEMINI_API_KEY=
