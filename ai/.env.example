 LLM provider
LLM_PROVIDER=openrouter
LLM_TIMEOUT_SECONDS=120

# OpenRouter — replace the placeholder locally; never commit your real key
OPENROUTER_API_KEY=replace_with_your_key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=KK Store AI Assistant

# Existing Node.js backend (local development)
BACKEND_URL=http://localhost:5000

# Local infrastructure
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embeddings and retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Application-level LLM budget
LLM_MAX_CALLS_PER_MINUTE=5
LLM_MAX_CALLS_PER_DAY=30

# HTTP and browser access
HTTP_TIMEOUT_SECONDS=15
AI_ALLOWED_ORIGINS=http://localhost:5173
